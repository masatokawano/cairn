<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.masato.cairn.weekly</string>

    <!-- Sunday 18:00 + login `cairn review weekly` (DESIGN.md §5.7, M4/M6).
         The command targets the most recently CLOSED week (close = Sunday
         18:00 local), so the RunAtLoad login run only back-fills a week
         missed while the Mac was off — it never generates the in-progress
         week early. Exit 0 on creation and when the week already exists;
         a real error exits 1 and (via CAIRN_NOTIFY below) posts a macOS
         notification. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{BACKEND_DIR}}/bin/cairn</string>
        <string>review</string>
        <string>weekly</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{BACKEND_DIR}}</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/weekly.log</string>

    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/weekly-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CAIRN_OBSIDIAN_VAULT</key>
        <string>{{OBSIDIAN_VAULT}}</string>
        <key>CAIRN_EXTERNAL_BRAIN_DIR</key>
        <string>{{EXTERNAL_BRAIN_DIR}}</string>
        <!-- M6/S4: non-zero exit → macOS notification + failures.log entry -->
        <key>CAIRN_NOTIFY</key>
        <string>1</string>
        <key>CAIRN_AGENT</key>
        <string>weekly</string>
        <key>CAIRN_LOG_DIR</key>
        <string>{{LOG_DIR}}</string>
        <!-- related() semantic uses the cached e5 weights; stay offline -->
        <key>HF_HUB_OFFLINE</key>
        <string>1</string>
        <key>TRANSFORMERS_OFFLINE</key>
        <string>1</string>
    </dict>
</dict>
</plist>
