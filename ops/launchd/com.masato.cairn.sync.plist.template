<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.masato.cairn.sync</string>

    <!-- hourly `cairn sync all`: conversations + karakeep + zotero +
         obsidian, then the 90 Auto lists (DESIGN.md §5.7) -->
    <key>ProgramArguments</key>
    <array>
        <string>{{BACKEND_DIR}}/bin/cairn</string>
        <string>sync</string>
        <string>all</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{BACKEND_DIR}}</string>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/sync.log</string>

    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/sync-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- API keys stay in the Keychain (D8) — never here -->
        <key>CAIRN_KARAKEEP_URL</key>
        <string>{{KARAKEEP_URL}}</string>
        <key>CAIRN_ZOTERO_USER_ID</key>
        <string>{{ZOTERO_USER_ID}}</string>
        <key>CAIRN_OBSIDIAN_VAULT</key>
        <string>{{OBSIDIAN_VAULT}}</string>
        <key>CAIRN_EXTERNAL_BRAIN_DIR</key>
        <string>{{EXTERNAL_BRAIN_DIR}}</string>
        <!-- M6/S4: non-zero exit → macOS notification + failures.log entry.
             Keyed on exit code, so the noisy stderr below is irrelevant. -->
        <key>CAIRN_NOTIFY</key>
        <string>1</string>
        <key>CAIRN_AGENT</key>
        <string>sync</string>
        <key>CAIRN_LOG_DIR</key>
        <string>{{LOG_DIR}}</string>
        <!-- e5 embedding weights are already cached locally; go offline to
             drop the HF-Hub warnings that flood sync-error.log -->
        <key>HF_HUB_OFFLINE</key>
        <string>1</string>
        <key>TRANSFORMERS_OFFLINE</key>
        <string>1</string>
    </dict>
</dict>
</plist>
